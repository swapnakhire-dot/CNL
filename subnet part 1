#include <stdio.h>

int main()
{
    int a, b, c, d;

    printf("Enter IP address: ");
    scanf("%d.%d.%d.%d", &a, &b, &c, &d);

    if (a < 1 || a > 255 ||
        b < 0 || b > 255 ||
        c < 0 || c > 255 ||
        d < 0 || d > 255)
    {
        printf("Invalid IP address.\n");
        return 0;
    }

    if (a >= 1 && a <= 126)
        printf("IP Class: A\n");
    else if (a >= 128 && a <= 191)
        printf("IP Class: B\n");
    else if (a >= 192 && a <= 223)
        printf("IP Class: C\n");
    else if (a >= 224 && a <= 239)
        printf("IP Class: D\n");
    else
        printf("IP Class: E\n");

    return 0;
}
